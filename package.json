{
  "name": "short-sha",
  "version": "0.0.0",
  "private": true,
  "description": "Github Action to shorten the git SHA1 and make it accessible in outputs",
  "keywords": [
    "actions",
    "git"
  ],
  "license": "MIT",
  "author": "benjlevesque",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjlevesque/short-sha.git"
  },
  "type": "module",
  "main": "lib/main.js",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "build": "tsc && ncc build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "tsx --test"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^5.1.1"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.6",
    "@vercel/ncc": "^0.34.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
