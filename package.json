{
  "name": "short-sha",
  "version": "0.0.0",
  "private": true,
  "description": "Github Action to shorten the git SHA1 and make it accessible in outputs",
  "keywords": [
    "actions",
    "git"
  ],
  "license": "MIT",
  "author": "benjlevesque",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjlevesque/short-sha.git"
  },
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "rolldown -c",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "tsx --test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@tsconfig/node26": "26.0.1",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "rolldown": "1.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26"
  }
}
